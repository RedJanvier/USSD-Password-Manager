# Copy to .env for local dev. NEVER commit .env.

# Database — defaults to local SQLite for dev; Render auto-injects Postgres in prod.
DATABASE_URL=sqlite+aiosqlite:///./vault.db
# Production example (Render Postgres):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# 32-byte hex secret added to PIN/recovery KDF inputs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotating this invalidates every user's PIN. Set once and back it up.
APP_PEPPER=replace-me-with-64-hex-chars

# Africa's Talking credentials. Use "sandbox" while testing.
AT_USERNAME=sandbox
AT_API_KEY=your-at-api-key
AT_SHORTCODE=*384*12345#

# Optional: log level
LOG_LEVEL=INFO
